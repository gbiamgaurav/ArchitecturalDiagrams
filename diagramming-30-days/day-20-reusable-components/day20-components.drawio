"Telemetry" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#1f2328;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1394" y="489" width="162" height="26" as="geometry"/></mxCell><mxCell id="s85" value="Dashed, open head." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#1f2328;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1394" y="519" width="162" height="22" as="geometry"/></mxCell><mxCell id="s86" value="mute grey" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#57606a;fontStyle=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1394" y="593" width="162" height="22" as="geometry"/></mxCell><mxCell id="s87" value="" style="rounded=1;arcSize=4;html=1;fillColor=#ffffff;strokeColor=#d0d7de;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="644" width="362" height="160" as="geometry"/></mxCell><mxCell id="s88" value="" style="endArrow=none;html=1;strokeWidth=2;strokeColor=#1f2328;dashed=1;dashPattern=10 6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="136" y="664" as="sourcePoint"/><mxPoint x="136" y="784" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s89" value="Trust boundary" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#1f2328;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="236" y="665" width="162" height="26" as="geometry"/></mxCell><mxCell id="s90" value="2 px dashed line where" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#1f2328;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="236" y="695" width="162" height="22" as="geometry"/></mxCell><mxCell id="s91" value="data crosses trust zones." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#1f2328;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="236" y="712" width="162" height="22" as="geometry"/></mxCell><mxCell id="s92" value="ink" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#57606a;fontStyle=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="236" y="769" width="162" height="22" as="geometry"/></mxCell><mxCell id="s93" value="" style="rounded=1;arcSize=3;html=1;fillColor=#f6f8fa;strokeColor=#d0d7de;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="426" y="644" width="1134" height="160" as="geometry"/></mxCell><mxCell id="s94" value="How to use the library in Draw.io" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#1f2328;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="446" y="661" width="500" height="26" as="geometry"/></mxCell><mxCell id="s95" value="1. File → Open Library from → Device → pick day20-component-library.xml. It appears in the left sidebar." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#1f2328;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="446" y="694" width="1094" height="24" as="geometry"/></mxCell><mxCell id="s96" value="2. Drag a shape onto the page. Double-click to rename it. Don&#x27;t restyle it: the style is the point." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#1f2328;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="446" y="716" width="1094" height="24" as="geometry"/></mxCell><mxCell id="s97" value="3. To update: change the shape on a page → drag it into the library panel → Save. New diagrams get the new version." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#1f2328;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="446" y="738" width="1094" height="24" as="geometry"/></mxCell><mxCell id="s98" value="4. Need a vendor&#x27;s exact service (e.g. AWS Bedrock vs Azure OpenAI)? + More Shapes → AWS / Azure / Kubernetes icons." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#1f2328;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="446" y="760" width="1094" height="24" as="geometry"/></mxCell><mxCell id="s99" value="" style="rounded=1;arcSize=10;html=1;fillColor=#ffffff;strokeColor=#d0d7de;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="829" width="1520" height="34" as="geometry"/></mxCell><mxCell id="s100" value="Legend" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#57606a;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="52" y="834" width="60" height="24" as="geometry"/></mxCell><mxCell id="s101" value="" style="rounded=1;html=1;fillColor=#ddf4ff;strokeColor=#0969da;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="140" y="837" width="32" height="18" as="geometry"/></mxCell><mxCell id="s102" value="ours" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#1f2328;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="184" y="835" width="140" height="22" as="geometry"/></mxCell><mxCell id="s103" value="" style="rounded=1;html=1;fillColor=#fff1e5;strokeColor=#bc4c00;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="340" y="837" width="32" height="18" as="geometry"/></mxCell><mxCell id="s104" value="external" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#1f2328;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="384" y="835" width="140" height="22" as="geometry"/></mxCell><mxCell id="s105" value="" style="rounded=1;html=1;fillColor=#f6f8fa;strokeColor=#57606a;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="540" y="837" width="32" height="18" as="geometry"/></mxCell><mxCell id="s106" value="person" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#1f2328;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="584" y="835" width="140" height="22" as="geometry"/></mxCell><mxCell id="s107" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=1.5;strokeColor=#1f2328;endArr