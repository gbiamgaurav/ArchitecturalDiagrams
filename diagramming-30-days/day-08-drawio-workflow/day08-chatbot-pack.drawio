<mxfile host="app.diagrams.net"><diagram id="page-flowchart" name="Flowchart"><mxGraphModel dx="1100" dy="880" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="880" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="main" value="Main" parent="0"/><mxCell id="errors" value="Error paths" parent="0"/><mxCell id="notes" value="Notes" parent="0"/><mxCell id="title" value="AI chat with a safety check — flowchart" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="main"><mxGeometry x="40" y="20" width="700" height="30" as="geometry"/></mxCell><mxCell id="subtitle" value="Page 1 of 2 · Layers: Main · Error paths · Notes" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#57606a;" vertex="1" parent="main"><mxGeometry x="40" y="48" width="700" height="20" as="geometry"/></mxCell><mxCell id="start" value="User sends a message" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="main"><mxGeometry x="170" y="90" width="180" height="50" as="geometry"/></mxCell><UserObject label="Check message with&lt;br&gt;the safety filter" tooltip="Safety filter = a small service that flags harmful or off-topic messages before they reach the LLM." id="filter"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="main"><mxGeometry x="170" y="175" width="180" height="60" as="geometry"/></mxCell></UserObject><mxCell id="safe" value="Safe?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="main"><mxGeometry x="190" y="270" width="140" height="90" as="geometry"/></mxCell><UserObject label="Send prompt to the LLM" tooltip="The app sends the message plus chat history to the LLM and waits up to 20 seconds." id="llm"><mxCell style="rounded=1;arcSize=10