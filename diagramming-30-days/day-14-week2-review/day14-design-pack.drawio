<mxfile host="app.diagrams.net"><diagram id="pg-overview" name="Overview"><mxGraphModel dx="1400" dy="820" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="820" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t1" value="Weather assistant — mini design pack" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontColor=#1f2328;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="22" width="900" height="20" as="geometry"/></mxCell><mxCell id="t2" value="Weather assistant · design pack v1.0 · 2026-11-13 · page 1 of 4" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#6e7781;" vertex="1" parent="1"><mxGeometry x="40" y="46" width="600" height="20" as="geometry"/></mxCell><UserObject label="State" link="data:page/id,pg-state" id="tab3"><mxCell style="rounded=1;arcSize=40;html=1;fillColor=#ffffff;strokeColor=#d0d7de;fontColor=#0969da;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1301" y="22" width="53" height="22" as="geometry"/></mxCell></UserObject><UserObject label="Flowchart" link="data:page/id,pg-flowchart" id="tab4"><mxCell style="rounded=1;arcSize=40;html=1;fillColor=#ffffff;strokeColor=#d0d7de;fontColor=#0969da;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1214" y="22" width="81" height="22" as="geometry"/></mxCell></UserObject><UserObject label="Sequence" link="data:page/id,pg-sequence" id="tab5"><mxCell style="rounded=1;arcSize=40;html=1;fillColor=#ffffff;strokeColor=#d0d7de;fontColor=#0969da;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1134" y="22" width="74" height="22" as="geometry"/></mxCell></UserObject><mxCell id="tab6" value="Overview" style="rounded=1;arcSize=40;html=1;fillColor=#0969da;strokeColor=#0969da;fontColor=#ffffff;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1054" y="22" width="74" height="22" as="geometry"/></mxCell><mxCell id="t7" value="Three questions, three diagrams. Each diagram answers ONE question, and none of them repeats another." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#57606a;" vertex="1" parent="1"><mxGeometry x="40" y="78" width="900" height="20" as="geometry"/></mxCell><mxCell id="card8" value="" style="rounded=1;arcSize=4;html=1;fillColor=#ffffff;strokeColor=#d0d7de;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="420" height="290" as="geometry"/></mxCell><mxCell id="badge9" value="Q1" style="ellipse;html=1;fillColor=#0969da;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="58" y="138" width="34" height="34" as="geometry"/></mxCell><mxCell id="t10" value="Who talks to whom when the" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontColor=#1f2328;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="104" y="136" width="340" height="20" as="geometry"/></mxCell><mxCell id="t11" value="assistant uses a tool?" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontColor=#1f2328;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="104" y="156" width="340" height="20" as="geometry"/></mxCell><mxCell id="t12" value="→ Sequence diagram" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#0969da;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="194" width="300" height="20" as="geometry"/></mxCell><mxCell id="t13" value="Why this type:" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#6e7781;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="220" width="200" height="20" as="geometry"/></mxCell><mxCell id="t14" value="Many parts pass messages," style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#1f2328;" vertex="1" parent="1"><mxGeometry x="60" y="238" width="380" height="20" as="geometry"/></mxCell><mxCell id="t15" value="and the ORDER matters." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#1f2328;" vertex="1" parent="1"><mxGeometry x="60" y="254" width="380" height="20" as="geometry"/></mxCell><UserObject label="Open the Sequence page →" link="data:page/id,pg-sequence" id="open16"><mxCell style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=5;fontColor=#0969da;" vertex="1" parent="1"><mxGeometry x="60" y="378" width="240" height="20" as="geometry"/></mxCell></UserObject><mxCell id="card17" value="" style="rounded=1;arcSize=4;html=1;fillColor=#ffffff;strokeColor=#d0d7de;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="490" y="120" width="420" height="290" as="geometry"/></mxCell><mxCell id="badge18" value="Q2" style="ellipse;html=1;fillColor=#0969da;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="508" y="138" width="34" height="34" as="geometry"/></mxCell><mxCell id="t19" value="What does the Host decide" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontColor=#1f2328;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="554" y="136" width="340" height="20" as="geometry"/></mxCell><mxCell id="t20" value="on each turn?" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontColor=#1f2328;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="554" y="156" width="340" height="20" as="geometry"/></mxCell><mxCell id="t21" value="→ Flowchart" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#0969da;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="510" y="194" width="300" height="20" as="geometry"/></mxCell><mxCell id="t22" value="Why this type:" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#6e7781;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="510" y="220" width="200" height="20" as="geometry"/></mxCell><mxCell id="t23" value="One process with yes / no" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#1f2328;" vertex="1" parent="1"><mxGeometry x="510" y="238" width="380" height="20" as="geometry"/></mxCell><mxCell id="t24" value="choices and a loop." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#1f2328;" vertex="1" parent="1"><mxGeometry x="510" y="254" width="380" height="20" as="geometry"/></mxCell><UserObject label="Open the Flowchart page →" link="data:page/id,pg-flowchart" id="open25"><mxCell style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=5;fontColor=#0969da;" vertex="1" parent="1"><mxGeometry x="510" y="378" width="240" height="20" as="geometry"/></mxCell></UserObject><mxCell id="card26" value="" style="rounded=1;arcSize=4;html=1;fillColor=#ffffff;strokeColor=#d0d7de;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="940" y="120" width="420" height="290" as="geometry"/></mxCell><mxCell id="badge27" value="Q3" style="ellipse;html=1;fillColor=#0969da;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="958" y="138" width="34" height="34" as="geometry"/></mxCell><mxCell id="t28" value="What states can one tool" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontColor=#1f2328;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1004" y="136" width="340" height="20" as="geometry"/></mxCell><mxCell id="t29" value="call (tc_1) be in?" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontColor=#1f2328;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1004" y="156" width="340" height="20" as="geometry"/></mxCell><mxCell id="t30" value="→ State diagram" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#0969da;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="960" y="194" width="300" height="20" as="geometry"/></mxCell><mxCell id="t31" value="Why this type:" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#6e7781;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="960" y="220" width="200" height="20" as="geometry"/></mxCell><mxCell id="t32" value="One thing that changes over" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#1f2328;" vertex="1" parent="1"><mxGeometry x="960" y="238" width="380" height="20" as="geometry"/></mxCell><mxCell id="t33" value="time and has an end." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#1f2328;" vertex="1" parent="1"><mxGeometry x="960" y="254" width="380" height="20" as="geometry"/></mxCell><UserObject label="Open the State page →" link="data:page/id,pg-state" id="open34"><mxCell style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=5;fontColor=#0969da;" vertex="1" parent="1"><mxGeometry x="960" y="378" width="240" height="20" as="geometry"/></mxCell></UserObject><mxCell id="gl35" value="" style="rounded=1;arcSize=3;html=1;fillColor=#ffffff;strokeColor=#d0d7de;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="435" width="640" height="275" as="geometry"/></mxCell><mxCell id="t36" value="Same names on every page" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f2328;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="58" y="447" width="400" height="20" as="geometry"/></mxCell><mxCell id="gc37" value="User" style="rounded=1;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="474" width="120" height="26" as="geometry"/></mxCell><mxCell id="t38" value="the person asking" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#1f2328;" vertex="1" parent="1"><mxGeometry x="196" y="477" width="440" height="20" as="geometry"/></mxCell><mxCell id="gc39" value="Host" style="rounded=1;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="509" width="120" height="26" as="geometry"/></mxCell><mxCell id="t40" value="our chat app; runs the show" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#1f2328;" vertex="1" parent="1"><mxGeometry x="196" y="512" width="440" height="20" as="geometry"/></mxCell><mxCell id="gc41" value="Model" style="rounded=1;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="544" width="120" height="26" as="geometry"/></mxCell><mxCell id="t42" value="the LLM; only ASKS for tools" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#1f2328;" vertex="1" parent="1"><mxGeometry x="196" y="547" width="440" height="20" as="geometry"/></mxCell><mxCell id="gc43" value="MCP Client" style="rounded=1;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="579" width="120" height="26" as="geometry"/></mxCell><mxCell id="t44" value="part of the Host; talks to servers" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#1f2328;" vertex="1" parent="1"><mxGeometry x="196" y="582" width="440" height="20" as="geometry"/></mxCell><mxCell id="gc45" value="MCP Server" style="rounded=1;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="614" width="120" height="26" as="geometry"/></mxCell><mxCell id="t46" value="external; offers get_weather" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#1f2328;" vertex="1" parent="1"><mxGeometry x="196" y="617" width="440" height="20" as="geometry"/></mxCell><mxCell id="gc47" value="tc_1" style="rounded=1;html=1;fillColor=#f6f8fa;strokeColor=#8c959f;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="649" width="120" height="26" as="geometry"/></mxCell><mxCell id="t48" value="id of one tool call, same on all pages" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#1f2328;" vertex="1" parent="1"><mxGeometry x="196" y="652" width="440" height="20" as="geometry"/></mxCell><mxCell id="rl49" value="" style="rounded=1;arcSize=3;html=1;fillColor=#ffffff;strokeColor=#d0d7de;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="720" y="435" width="640" height="275" as="geometry"/></mxCell><mxCell id="t50" value="Pack rules (keeping the source tidy)" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f2328;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="738" y="447" width="400" height="20" as="geometry"/></mxCell><mxCell id="t51" value="1. One .drawio file, one page per question." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#1f2328;" vertex="1" parent="1"><mxGeometry x="740" y="479" width="600" height="20" as="geometry"/></mxCell><mxCell id="t52" value="2. Every page: title, its question, a legend." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#1f2328;" vertex="1" parent="1"><mxGeometry x="740" y="509" width="600" height="20" as="geometry"/></mxCell><mxCell id="t53" value="3. Same colour = same meaning on every page:" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#1f2328;" vertex="1" parent="1"><mxGeometry x="740" y="539" width="600" height="20" as="geometry"/></mxCell><mxCell id="t54" value="4. Same names and ids everywhere (Host, tc_1)." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#1f2328;" vertex="1" parent="1"><mxGeometry x="740" y="599" width="600" height="20" as="geometry"/></mxCell><mxCell id="t55" value="5. Pages link to each other (tabs, top right)." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#1f2328;" vertex="1" parent="1"><mxGeometry x="740" y="629" width="600" height="20" as="geometry"/></mxCell><mxCell id="t56" value="6. PNGs are exports. Edit the .drawio, then re-export." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#1f2328;" vertex="1" parent="1"><mxGeometry x="740" y="659" width="600" height="20" as="geometry"/></mxCell><mxCell id="chip57" value="" style="rounded=1;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="760" y="571" width="18" height="16" as="geometry"/></mxCell><mxCell id="t58" value="our app" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#1f2328;" vertex="1" parent="1"><mxGeometry x="784" y="569" width="80" height="20" as="geometry"/></mxCell><mxCell id="chip59" value="" style="rounded=1;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="848" y="571" width="18" height="16" as="geometry"/></mxCell><mxCell id="t60" value="Model" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#1f2328;" vertex="1" parent="1"><mxGeometry x="872" y="569" width="80" height="20" as="geometry"/></mxCell><mxCell id="chip61" value="" style="rounded=1;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="924" y="571" width="18" height="16" as="geometry"/></mxCell><mxCell id="t62" value="external" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#1f2328;" vertex="1" parent="1"><mxGeometry x="948" y="569" width="80" height="20" as="geometry"/></mxCell><mxCell id="chip63" value="" style="rounded=1;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1018" y="571" width="18" height="16" as="geometry"/></mxCell><mxCell id="t64" value="success" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#1f2328;" vertex="1" parent="1"><mxGeometry x="1042" y="569" width="80" height="20" as="geometry"/></mxCell><mxCell id="chip65" value="" style="rounded=1;html=1;fillColor=#ffebe9;strokeColor=#cf222e;" vertex="1" parent="1"><mxGeometry x="1106" y="571" width="18" height="16" as="geometry"/></mxCell><mxCell id="t66" value="error" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#1f2328;" vertex="1" parent="1"><mxGeometry x="1130" y="569" width="80" height="20" as="geometry"/></mxCell><mxCell id="chip67" value="" style="rounded=1;html=1;fillColor=#ffffff;strokeColor=#57606a;" vertex="1" parent="1"><mxGeometry x="1182" y="571" width="18" height="16" as="geometry"/></mxCell><mxCell id="t68" value="decision" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#1f2328;" vertex="1" parent="1"><mxGeometry x="1206" y="569" width="80" height="20" as="geometry"/></mxCell><mxCell id="t69" value="Not in this pack (on purpose): class diagram, ER diagram. They answer &#x27;how is the code / data built?&#x27;, which isn&#x27;t one of our 3 questions." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#6e7781;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="40" y="750" width="1100" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="pg-sequence" name="Sequence"><mxGraphModel dx="1400" dy="820" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="820" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t1" value="Q1 · Sequence diagram" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontColor=#1f2328;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="22" width="900" height="20" as="geometry"/></mxCell><mxCell id="t2" value="Weather assistant · design pack v1.0 · 2026-11-13 · page 2 of 4" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#6e7781;" vertex="1" parent="1"><mxGeometry x="40" y="46" width="600" height="20" as="geometry"/></mxCell><mxCell id="q3" value="Q1 · Who talks to whom when the assistant uses a tool?" style="rounded=1;html=1;fillColor=#ddf4ff;strokeColor=#0969da;fontSize=13;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="72" width="820" height="30" as="geometry"/></mxCell><UserObject label="State" link="data:page/id,pg-state" id="tab4"><mxCell style="rounded=1;arcSize=40;html=1;fillColor=#ffffff;strokeColor=#d0d7de;fontColor=#0969da;fon