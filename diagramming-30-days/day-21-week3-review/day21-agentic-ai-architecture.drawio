tml=1;fillColor=#1f2328;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="589" y="415" width="22" height="22" as="geometry"/></mxCell><mxCell id="b52" value="5" style="ellipse;html=1;fillColor=#1f2328;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="841" y="415" width="22" height="22" as="geometry"/></mxCell><mxCell id="b53" value="6" style="ellipse;html=1;fillColor=#1f2328;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1069" y="273" width="22" height="22" as="geometry"/></mxCell><mxCell id="b54" value="7" style="ellipse;html=1;fillColor=#1f2328;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1069" y="415" width="22" height="22" as="geometry"/></mxCell><mxCell id="b55" value="8" style="ellipse;html=1;fillColor=#1f2328;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="337" y="719" width="22" height="22" as="geometry"/></mxCell><mxCell id="b56" value="1" style="ellipse;html=1;fillColor=#1f2328;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1636" y="280" width="22" height="22" as="geometry"/></mxCell><mxCell id="t57" value="&lt;b&gt;User&lt;/b&gt; asks a question in the Web UI." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1f2328;spacingTop=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1668" y="278" width="212" height="18" as="geometry"/></mxCell><mxCell id="b58" value="2" style="ellipse;html=1;fillColor=#1f2328;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1636" y="318" width="22" height="22" as="geometry"/></mxCell><mxCell id="t59" value="&lt;b&gt;Web UI&lt;/b&gt; sends it to the API Gateway. The answer streams back (SSE)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1f2328;spacingTop=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1668" y="316" width="212" height="32" as="geometry"/></mxCell><mxCell id="b60" value="3" style="ellipse;html=1;fillColor=#1f2328;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1636" y="370" width="22" height="22" as="geometry"/></mxCell><mxCell id="t61" value="&lt;b&gt;API Gateway&lt;/b&gt; checks the login with the Identity provider and limits requests." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1f2328;spacingTop=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1668" y="368" width="212" height="32" as="geometry"/></mxCell><mxCell id="b62" value="4" style="ellipse;html=1;fillColor=#1f2328;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1636" y="422" width="22" height="22" as="geometry"/></mxCell><mxCell id="t63" value="&lt;b&gt;Chat API&lt;/b&gt; loads the chat history and hands the question to the agent." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1f2328;spacingTop=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1668" y="420" width="212" height="32" as="geometry"/></mxCell><mxCell id="b64" value="5" style="ellipse;html=1;fillColor=#1f2328;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1636" y="474" width="22" height="22" as="geometry"/></mxCell><mxCell id="t65" value="&lt;b&gt;Agent Orchestrator&lt;/b&gt; runs the plan → act loop. Guardrails check input and output." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1f2328;spacingTop=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1668" y="472" width="212" height="32" as="geometry"/></mxCell><mxCell id="b66" value="6" style="ellipse;html=1;fillColor=#1f2328;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1636" y="526" width="22" height="22" as="geometry"/></mxCell><mxCell id="t67" value="&lt;b&gt;LLM client&lt;/b&gt; sends the prompt to the LLM API." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1f2328;spacingTop=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1668" y="524" width="212" height="32" as="geometry"/></mxCell><mxCell id="b68" value="7" style="ellipse;html=1;fillColor=#1f2328;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1636" y="578" width="22" height="22" as="geometry"/></mxCell><mxCell id="t69" value="&lt;b&gt;Tool Router&lt;/b&gt; calls tools over MCP: Weather (third party) or our Docs server, which searches the Vector DB." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1f2328;spacingTop=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1668" y="576" width="212" height="46" as="geometry"/></mxCell><mxCell id="b70" value="8" style="ellipse;html=1;fillColor=#1f2328;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1636" y="644" width="22" height="22" as="geometry"/></mxCell><mxCell id="t71" value="&lt;b&gt;OTel collector&lt;/b&gt; gets telemetry from every service and forwards it to Monitoring." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1f2328;spacingTop=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1668" y="642" width="212" height="32" as="geometry"/></mxCell><mxCell id="n72" value="&lt;b&gt;Left dashed line.&lt;/b&gt; Everything from the internet is untrusted. Check it at the API Gateway." style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#f6f8fa;strokeColor=#d0d7de;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=10;fontSize=11;fontColor=#1f2328;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1636" y="704" width="244" height="60" as="geometry"/></mxCell><mxCell id="n73" value="&lt;b&gt;Right dashed line.&lt;/b&gt; Prompts and tool calls leave our cloud here. Send no secrets and as little personal data as possible." style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#f6f8fa;strokeColor=#d0d7de;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=10;fontSize=11;fontColor=#1f2328;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1636" y="776" width="244" height="62" as="geometry"/></mxCell><mxCell id="n74" value="&lt;b&gt;Every orange box&lt;/b&gt; can fail, cost money, or see our data." style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#f6f8fa;strokeColor=#d0d7de;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=10;fontSize=11;fontColor=#1f2328;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1636" y="854" width="244" height="50" as="geometry"/></mxCell><mxCell id="leg" value="" style="rounded=1;arcSize=10;html=1;fillColor=#ffffff;strokeColor=#d0d7de;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="984" width="1840" height="56" as="geometry"/></mxCell><mxCell id="t75" value="Legend" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#57606a;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="56" y="1000" width="70" height="24" as="geometry"/></mxCell><mxCell id="k76" value="" style="rounded=1;arcSize=12;html=1;fillColor=#ddf4ff;strokeColor=#0969da;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="150" y="1002" width="36" height=