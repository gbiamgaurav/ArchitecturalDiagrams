x="40" y="40" width="700" height="44" as="geometry"/></mxCell><mxCell id="t73" value="Every row 36 px · every lifeline 240 px apart · every participant box 160 × 46" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#57606a;" vertex="1" parent="frame"><mxGeometry x="40" y="78" width="700" height="24" as="geometry"/></mxCell><mxCell id="ver" value="v1.0 · polished · 2026-11-13" style="rounded=1;html=1;fillColor=#f6f8fa;strokeColor=#d0d7de;fontSize=11;fontColor=#57606a;" vertex="1" parent="frame"><mxGeometry x="1340" y="48" width="220" height="26" as="geometry"/></mxCell><mxCell id="note74" value="①–⑤ run once, when the app starts.&lt;br&gt;JSON-RPC 2.0 over stdio." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#fff8c5;strokeColor=#d4a72c;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="frame"><mxGeometry x="1260" y="235" width="300" height="46" as="geometry"/></mxCell><mxCell id="note75" value="③ is a notification: no id, so no&lt;br&gt;reply. Orange = async." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#fff8c5;strokeColor=#d4a72c;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="frame"><mxGeometry x="1260" y="307" width="300" height="46" as="geometry"/></mxCell><mxCell id="note76" value="⑧ The Model only ASKS for the tool.&lt;br&gt;Host + MCP Client run it (⑨–⑫)." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#fff8c5;strokeColor=#d4a72c;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="frame"><mxGeometry x="1260" y="523" width="300" height="46" as="geometry"/></mxCell><mxCell id="note77" value="⑩ The Server calls the real weather&lt;br&gt;API. The only step that does work." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#fff8c5;strokeColor=#d4a72c;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="frame"><mxGeometry x="1260" y="595" width